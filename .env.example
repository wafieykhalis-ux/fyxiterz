# =============================================================================
# FYXITERZ — Environment configuration (example)
# Copy to `.env` locally. NEVER commit real secrets.
#
# Two consumers read configuration:
#   1. The browser app reads assets/js/config.js  (PUBLIC values only)
#   2. Supabase Edge Functions read the secrets below via `supabase secrets set`
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Edge Functions get SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# automatically when deployed. Declare them here for local `supabase functions
# serve` and for reference. Public anon key is ALSO copied into config.js.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY        # backend only — never ship to browser

# -----------------------------------------------------------------------------
# Public site URL — used to build gateway return / redirect URLs
# -----------------------------------------------------------------------------
PUBLIC_SITE_URL=https://YOUR-USERNAME.github.io/fyxiterz

# -----------------------------------------------------------------------------
# Payment gateway — choose ONE provider ("chip" or "toyyibpay")
# Must match assets/js/config.js PAYMENT_PROVIDER.
#
# Touch 'n Go eWallet is OFFERED THROUGH CHIP (channel id "tng_ewallet"), so use
# provider "chip" if you want to accept TNG eWallet. ToyyibPay supports FPX and
# card only and does not offer TNG eWallet.
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=chip

# --- CHIP (https://chip-in.asia) — supports Touch 'n Go eWallet ---
CHIP_SECRET_KEY=YOUR_CHIP_BRAND_SECRET_KEY
CHIP_BRAND_ID=YOUR_CHIP_BRAND_ID
CHIP_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...RSA public key used to verify webhooks...\n-----END PUBLIC KEY-----"
# In the CHIP portal, enable the "Touch 'n Go eWallet" payment channel for your brand.

# --- ToyyibPay (https://toyyibpay.com) — FPX / card only, NO TNG eWallet ---
TOYYIBPAY_SECRET_KEY=YOUR_TOYYIBPAY_USER_SECRET_KEY
TOYYIBPAY_CATEGORY_CODE=YOUR_TOYYIBPAY_CATEGORY_CODE
